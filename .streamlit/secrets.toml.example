# Plantilla de conexión y autenticación. Copia este archivo como secrets.toml
# y completa la contraseña. NUNCA subas secrets.toml a un repositorio público
# ni lo incluyas en el .zip de entrega.
[mysql]
host = "virtualaprendo.online"
port = 3306
database = "dbfacturas"
user = "dbfacturas"
password = ""

# Autenticación: la sección [auth] la crea automáticamente:
#   python configurar_auth.py init
# No la escribas a mano si no es necesario. Queda así:
#
# [auth]
# jwt_secret = "<64 caracteres aleatorios>"
# token_minutos = 30
# max_intentos = 5
# bloqueo_minutos = 5
# issuer = "facturacion-streamlit"
#
# [auth.users."admin"]
# nombre = "Administrador"
# rol = "admin"            # admin | vendedor | consulta
# activo = true
# password_hash = "pbkdf2_sha256$600000$...$..."
#
# Para agregar usuarios:
#   python configurar_auth.py agregar vendedor vendedor
# Para revisar la configuración:
#   python configurar_auth.py validar
